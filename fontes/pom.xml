<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<name>WeDoCode Shopping :: root</name>
	<description>Cube MVP architectural reference — Java 25 + React 19 e-commerce demo</description>
	<url>https://github.com/mrcdom/wdc-cube-java-v2</url>
	<inceptionYear>2026</inceptionYear>

	<scm>
		<url>https://github.com/mrcdom/wdc-cube-java-v2</url>
		<connection>scm:git:https://github.com/mrcdom/wdc-cube-java-v2.git</connection>
		<developerConnection>scm:git:git@github.com:mrcdom/wdc-cube-java-v2.git</developerConnection>
	</scm>

	<groupId>br.com.wdc</groupId>
	<artifactId>br.com.wdc.cube.parent</artifactId>
	<version>2.0.0</version>

	<packaging>pom</packaging>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<organization>
		<name>WeDoCode Consultoria LTDA</name>
		<url>https://wedocode.com.br</url>
	</organization>

	<developers>
		<developer>
			<name>Marcelo Domingos</name>
			<organization>WeDoCode Consultoria LTDA</organization>
			<organizationUrl>https://wedocode.com.br</organizationUrl>
		</developer>
	</developers>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- Demos and backend; the framework (published to Central) stays at 21 in its own pom -->
		<maven.compiler.release>25</maven.compiler.release>
	</properties>

	<distributionManagement>
		<repository>
			<id>artifactory-wedocode-release</id>
			<name>libs-release-local</name>
			<url>${repo.url}/libs-release-local</url>
		</repository>
		<snapshotRepository>
			<id>artifactory-wedocode-snapshot</id>
			<name>libs-snapshot-local</name>
			<url>${repo.url}/libs-snapshot-local</url>
		</snapshotRepository>
	</distributionManagement>

	<modules>
		<module>br.com.wdc.framework</module>
		<module>br.com.wdc.shopping</module>
		<module>br.com.wdc.cube.backend</module>
	</modules>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-war-plugin</artifactId>
					<version>3.5.1</version>
				</plugin>
				<!--
					The executable (fat) JARs: each module adds only its Main-Class transformer. Duplicate metadata of the
					dependencies is dropped or merged here, so the build reports no overlaps.
				-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-shade-plugin</artifactId>
					<version>3.6.2</version>
					<configuration>
						<createDependencyReducedPom>false</createDependencyReducedPom>
						<transformers>
							<!-- One entry per service provider of every dependency -->
							<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
							<!-- One LICENSE, NOTICEs merged -->
							<transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer" />
							<transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer" />
						</transformers>
						<filters>
							<filter>
								<artifact>*:*</artifact>
								<excludes>
									<!-- A fat JAR is on the classpath, not a module -->
									<exclude>module-info.class</exclude>
									<exclude>META-INF/versions/*/module-info.class</exclude>
									<!-- Signatures of the original JARs no longer match -->
									<exclude>META-INF/*.SF</exclude>
									<exclude>META-INF/*.DSA</exclude>
									<exclude>META-INF/*.RSA</exclude>
									<!-- The manifest is the module's own (ManifestResourceTransformer) -->
									<exclude>META-INF/MANIFEST.MF</exclude>
									<exclude>META-INF/versions/*/OSGI-INF/MANIFEST.MF</exclude>
									<!-- Build and packaging metadata of the dependencies -->
									<exclude>META-INF/maven/**</exclude>
									<exclude>META-INF/proguard/**</exclude>
									<exclude>META-INF/jandex.idx</exclude>
									<exclude>META-INF/README*</exclude>
									<exclude>META-INF/licenses.xml</exclude>
									<exclude>about.html</exclude>
									<exclude>about_files/**</exclude>
								</excludes>
							</filter>
						</filters>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.16.0</version>
					<configuration>
						<release>25</release>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>