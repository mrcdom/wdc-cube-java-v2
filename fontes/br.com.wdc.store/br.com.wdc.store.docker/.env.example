# Copy to .env (ignored by git) and fill in.
# STORE_DB_PASSWORD, STORE_JWT_SECRET, STORE_MANAGEMENT_TOKEN: at least 32 random characters, e.g. `openssl rand -hex 24`.
# STORE_REMOTE_SIGNING_KEY: Base64 URL-safe, at least 32 bytes, e.g.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
STORE_DB_PASSWORD=
STORE_JWT_SECRET=
STORE_MANAGEMENT_TOKEN=
STORE_REMOTE_SIGNING_KEY=
