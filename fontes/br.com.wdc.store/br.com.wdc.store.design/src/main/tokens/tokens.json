{
  "$description": "The WDC Store's design tokens (W3C Design Tokens format): the single source of the palette, spacing, radii and type for every view technology. Generated code: GenerateDesignTokens.",
  "color": {
    "$type": "color",
    "primary": { "$value": "#0d66d0", "$description": "Brand blue: buttons, links, the selected item" },
    "primaryLight": { "$value": "#e8f1fc", "$description": "Tint behind primary content" },
    "primaryDark": { "$value": "#0a4f9e", "$description": "Primary pressed, hovered" },
    "primaryDarker": { "$value": "#083d7a", "$description": "Gradient end of the brand panel" },
    "accent": { "$value": "#1a8cff", "$description": "Brighter blue: gradients, highlights" },
    "accentSoft": { "$value": "#4da6ff", "$description": "Soft blue: gradient starts, decorations" },
    "onPrimary": { "$value": "#ffffff", "$description": "Text and icons on primary" },
    "background": { "$value": "#f4f6f9", "$description": "The page behind the surfaces" },
    "surface": { "$value": "#ffffff", "$description": "Cards, panels, dialogs" },
    "surfaceMuted": { "$value": "#f8fafc", "$description": "A quieter surface: table headers, wells" },
    "surfaceSubtle": { "$value": "#eef2f7", "$description": "Hover on a surface, placeholders" },
    "text": { "$value": "#1d1d1f", "$description": "Body text" },
    "textSecondary": { "$value": "#6e6e73", "$description": "Captions, labels, secondary text" },
    "textMuted": { "$value": "#a1a1a6", "$description": "Hints, disabled text" },
    "border": { "$value": "#e5e5ea", "$description": "Dividers, card borders" },
    "borderStrong": { "$value": "#c1c1c6", "$description": "Input borders" },
    "error": { "$value": "#dc2626", "$description": "Errors, destructive actions, the cart badge" },
    "errorText": { "$value": "#991b1b", "$description": "Error text on errorBackground" },
    "errorBackground": { "$value": "#fef2f2", "$description": "Behind an error message" },
    "errorBorder": { "$value": "#fecaca", "$description": "Around an error message" },
    "success": { "$value": "#16a34a", "$description": "Success icons, confirmations" },
    "successText": { "$value": "#166534", "$description": "Success text on successBackground" },
    "successBackground": { "$value": "#f0fdf4", "$description": "Behind a success message" },
    "successBorder": { "$value": "#bbf7d0", "$description": "Around a success message" },
    "warning": { "$value": "#ff9800", "$description": "Warning icons" },
    "warningText": { "$value": "#9a3412", "$description": "Warning text on warningBackground" },
    "warningBackground": { "$value": "#fff7ed", "$description": "Behind a warning message" },
    "warningBorder": { "$value": "#fed7aa", "$description": "Around a warning message" },
    "highlight": { "$value": "#ffc107", "$description": "Stars, badges that call attention" }
  },
  "space": {
    "$type": "dimension",
    "xxs": { "$value": "4px" },
    "xs": { "$value": "8px" },
    "sm": { "$value": "12px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "20px" },
    "xl": { "$value": "24px" },
    "xxl": { "$value": "32px" },
    "xxxl": { "$value": "48px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px", "$description": "Inputs, small buttons" },
    "md": { "$value": "12px", "$description": "Cards, panels" },
    "lg": { "$value": "20px", "$description": "Large panels, sheets" },
    "pill": { "$value": "999px", "$description": "Pills, badges" }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px", "$description": "Badges, fine print" },
      "sm": { "$value": "14px", "$description": "Captions, secondary text" },
      "md": { "$value": "16px", "$description": "Body" },
      "lg": { "$value": "18px", "$description": "Emphasized body, prices" },
      "xl": { "$value": "20px", "$description": "Card titles" },
      "xxl": { "$value": "24px", "$description": "Section titles" },
      "display": { "$value": "32px", "$description": "Page titles" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"] }
    }
  }
}
