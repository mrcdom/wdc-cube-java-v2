<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.wdc</groupId>
        <artifactId>br.com.wdc.cube.parent</artifactId>
        <version>2.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>br.com.wdc.cube.backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>WeDoCode Cube Backend</name>
    <description>Standalone Javalin-based HTTP backend that assembles application modules and launches a single process (monorepo host)</description>

    <properties>
        <javalin.version>7.2.4</javalin.version>
        <!-- Version of the WDC Store application modules packaged by this backend -->
        <store.version>1.0.0</store.version>
        <!-- Working directory for exec:java (must contain config/application.toml) -->
        <workdir>${project.basedir}/../../work</workdir>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Framework BOM: managed versions (jackson, h2, agroal, postgresql, logback…) -->
            <dependency>
                <groupId>io.github.mrcdom.wdc.java</groupId>
                <artifactId>framework-dependencies</artifactId>
                <version>2.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Micrometer: metrics in Prometheus format at /metrics -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-bom</artifactId>
                <version>1.17.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Metrics in Prometheus format (Observability) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- WDC Store application: repository REST API -->
        <dependency>
            <groupId>br.com.wdc.store</groupId>
            <artifactId>persistence.rest</artifactId>
            <version>${store.version}</version>
        </dependency>

        <!-- WDC Store application: remote host (REST endpoints + business logic) -->
        <dependency>
            <groupId>br.com.wdc.store</groupId>
            <artifactId>remote.host</artifactId>
            <version>${store.version}</version>
        </dependency>
        <dependency>
            <groupId>br.com.wdc.store</groupId>
            <artifactId>br.com.wdc.store.scripts</artifactId>
            <version>${store.version}</version>
        </dependency>
        
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>        

        <!-- Javalin HTTP framework -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>

        <!-- Jackson for JSON serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        
        <!-- Connection pool + JTA integration -->
		<dependency>
			<groupId>io.agroal</groupId>
			<artifactId>agroal-api</artifactId>
		</dependency>
		<dependency>
			<groupId>io.agroal</groupId>
			<artifactId>agroal-pool</artifactId>
		</dependency>
		<dependency>
			<groupId>io.agroal</groupId>
			<artifactId>agroal-narayana</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jboss.narayana.jta</groupId>
			<artifactId>narayana-jta</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jboss.logging</groupId>
			<artifactId>jboss-logging</artifactId>
		</dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Shade Plugin for creating a fat JAR with all dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers combine.children="append">
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>br.com.wdc.cube.backend.BackendServer</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- exec:java launcher — usage: mvn exec:java (the repository's work/), or -Dworkdir=<folder> -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <mainClass>br.com.wdc.cube.backend.BackendServer</mainClass>
                    <arguments>
                        <argument>--workdir=${workdir}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
