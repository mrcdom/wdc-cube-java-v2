		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- Drivers do LocalDataSource (views locais): opcionais, quem o usa declara os dois -->
