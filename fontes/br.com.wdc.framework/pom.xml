<?xml version="1.0" encoding="UTF-8"?>
<!--
	Parent of the framework modules, published to Maven Central. It does not inherit from the root pom
	(br.com.wdc.cube.parent): whoever consumes the framework resolves only this tree, without the demos.

	Publishing: cd fontes/br.com.wdc.framework && mvn -Prelease clean deploy
	(portal credentials in the "central" server of settings.xml; signing through gpg-agent).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Central namespace verified through the GitHub account; "wdc.java" mirrors the "wdc.kt" of the Kotlin version -->
	<groupId>io.github.mrcdom.wdc.java</groupId>
	<artifactId>framework-parent</artifactId>
	<version>2.0.0</version>

	<packaging>pom</packaging>

	<name>framework-parent</name>
	<description>Cube MVP framework for Java: hierarchical presenters, intent navigation, serializable ViewStates and the data access layer</description>
	<url>https://github.com/mrcdom/wdc-cube-java-v2</url>
	<inceptionYear>2026</inceptionYear>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<organization>
		<name>WeDoCode Consultoria LTDA</name>
		<url>https://wedocode.com.br</url>
	</organization>

	<developers>
		<developer>
			<id>mrcdom</id>
			<name>Marcelo Domingos</name>
			<url>https://github.com/mrcdom</url>
			<organization>WeDoCode Consultoria LTDA</organization>
			<organizationUrl>https://wedocode.com.br</organizationUrl>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/mrcdom/wdc-cube-java-v2</url>
		<connection>scm:git:https://github.com/mrcdom/wdc-cube-java-v2.git</connection>
		<developerConnection>scm:git:git@github.com:mrcdom/wdc-cube-java-v2.git</developerConnection>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.release>21</maven.compiler.release>
	</properties>

	<modules>
		<module>br.com.wdc.framework.dependencies</module>
		<module>br.com.wdc.framework.commons</module>
		<module>br.com.wdc.framework.domain</module>
		<module>br.com.wdc.framework.jooq</module>
		<module>br.com.wdc.framework.persistence</module>
		<module>br.com.wdc.framework.cube</module>
		<module>br.com.wdc.framework.cube.remote</module>
	</modules>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.16.0</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<!-- Central requires, per artifact: a sources jar, a javadoc jar and a GPG signature -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.4.0</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.12.0</version>
						<configuration>
							<doclint>none</doclint>
							<quiet>true</quiet>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.12.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<!-- Stays "validated" on the portal; the release is manual, as in Kotlin -->
							<autoPublish>false</autoPublish>
							<waitUntil>validated</waitUntil>
							<!-- TypeScript source without a jar: the React bridge is not a Maven artifact -->
							<excludeArtifacts>
								<artifact>framework-cube-remote-bridge-react</artifact>
							</excludeArtifacts>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
