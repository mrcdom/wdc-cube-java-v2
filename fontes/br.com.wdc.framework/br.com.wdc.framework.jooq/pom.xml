<?xml version="1.0" encoding="UTF-8"?>
<!--
	Framework jOOQ — complementos genéricos ao jOOQ: DSLContext holder,
	utilitários de field/record e query builders com suporte a JSON (PostgreSQL).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.mrcdom.wdc.java</groupId>
		<artifactId>framework-parent</artifactId>
		<version>2.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>framework-jooq</artifactId>
	<name>framework-jooq</name>
	<description>Declarative jOOQ queries that load an object graph as JSON in one statement, with transaction-aware connections</description>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.github.mrcdom.wdc.java</groupId>
				<artifactId>framework-dependencies</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>io.github.mrcdom.wdc.java</groupId>
			<artifactId>framework-commons</artifactId>
		</dependency>
		<!-- Abstração de transação (TransactionScope) — o módulo jOOQ conhece transações, não o contrário -->
		<dependency>
			<groupId>io.github.mrcdom.wdc.java</groupId>
			<artifactId>framework-persistence</artifactId>
		</dependency>
		<dependency>
			<groupId>org.jooq</groupId>
			<artifactId>jooq</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-text</artifactId>
		</dependency>
	</dependencies>
</project>
