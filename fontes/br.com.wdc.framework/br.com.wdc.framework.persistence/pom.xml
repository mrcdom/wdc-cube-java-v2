<?xml version="1.0" encoding="UTF-8"?>
<!--
	Framework Persistence — controle de transação programático estilo CMT, dual-mode
	JTA/JDBC, e coordenador de transações remotas dirigidas pelo cliente (REST).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.mrcdom.wdc.java</groupId>
		<artifactId>framework-parent</artifactId>
		<version>2.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>framework-persistence</artifactId>
	<name>framework-persistence</name>
	<description>Programmatic CMT-style transactions, dual JTA/JDBC, and a coordinator for client-driven remote transactions</description>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.github.mrcdom.wdc.java</groupId>
				<artifactId>framework-dependencies</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>io.github.mrcdom.wdc.java</groupId>
			<artifactId>framework-commons</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.transaction</groupId>
			<artifactId>jakarta.transaction-api</artifactId>
		</dependency>
		
		<dependency>
			<groupId>io.github.mrcdom.wdc.java</groupId>
			<version>${project.version}</version>
			<artifactId>framework-domain</artifactId>
		</dependency>
	</dependencies>
</project>
