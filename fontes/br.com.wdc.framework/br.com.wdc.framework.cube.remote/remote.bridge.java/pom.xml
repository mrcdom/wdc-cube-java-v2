<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.mrcdom.wdc.java</groupId>
        <artifactId>framework-cube-remote-parent</artifactId>
        <version>2.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>framework-cube-remote-bridge-java</artifactId>
    <name>framework-cube-remote-bridge-java</name>

    <description>
        Java bridge for the Host/Shell remote protocol.
        Generic client that connects to a running Host as a Shell via WebSocket:
        negotiates the session, navigates the presenter hierarchy, submits events
        and reads ViewStates. Technology-agnostic — mirrors remote.bridge.flutter
        and remote.bridge.react for the Java ecosystem.
    </description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.mrcdom.wdc.java</groupId>
                <artifactId>framework-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Framework commons: Base62, Log -->
        <dependency>
            <groupId>io.github.mrcdom.wdc.java</groupId>
            <artifactId>framework-commons</artifactId>
        </dependency>

        <!-- JSON parsing -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- Logging: API only; the implementation is chosen by whoever uses the bridge -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Apache Commons: StringUtils -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>

</project>
