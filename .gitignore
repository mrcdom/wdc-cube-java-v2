# macOS
.DS_Store

# IDEs and local run configs
.idea/
.vscode/
.eclipse/

# Claude Code — personal overrides (the shared settings.json is versioned)
.claude/settings.local.json
*.iml
.project
.classpath
.settings/
.metadata/
.run/

# Eclipse workspace files
.ecp-*/
.mtj.tmp/
settings/
# JDT Language Server output folder (created even in aggregator pom modules)
bin/
# exception: work/bin holds the versioned start scripts
!work/bin/

# Build outputs and generated files
target/
dist/
node_modules/

# SCSS generated CSS (compiled by sass-cli-maven-plugin)
**/src/main/webapp/css/app.css

# Parcel + TeaVM generated resources in backend
fontes/br.com.wdc.cube.backend/src/main/resources/META-INF/resources/
dependency-reduced-pom.xml
.parcel-cache/
*.class
*.log
*.ctxt
*.jasper
hs_err_pid*
**/work/data/*.mv.db
**/work/data/*.trace.db

# Backend work directory (runtime only — consolidated at root work/)
fontes/br.com.wdc.cube.backend/work/

# Vaadin generated files
fontes/br.com.wdc.store/br.com.wdc.store.view.vaadin/src/main/frontend/generated/
fontes/br.com.wdc.store/br.com.wdc.store.view.vaadin/vite.generated.ts
fontes/br.com.wdc.store/br.com.wdc.store.view.vaadin/vite.config.ts
fontes/br.com.wdc.store/br.com.wdc.store.view.vaadin/tsconfig.json
fontes/br.com.wdc.store/br.com.wdc.store.view.vaadin/types.d.ts
fontes/br.com.wdc.store/br.com.wdc.store.view.vaadin/pnpmfile.cjs
fontes/br.com.wdc.store/br.com.wdc.store.view.vaadin/pnpm-lock.yaml
fontes/br.com.wdc.store/br.com.wdc.store.view.vaadin/package.json

# Flutter/Dart generated
.dart_tool/

# Local Maven CLI overrides (machine/platform specific)
**/.mvn/maven.config

# MCP server config (personal tooling, e.g. Playwright for browser inspection)
.mcp.json
.playwright-mcp/page-*.yml
